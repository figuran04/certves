# Google OAuth - fill these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database
# Local SQLite (default). Resolves relative to the app directory (data/cert.db).
DATABASE_URL=file:./data/cert.db
# To use Turso (global, shared across devices), paste the URL and token:
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=eyJ...

# Google Search Console verification token (the content value of the
# "google-site-verification" meta tag). Optional - only needed to verify
# domain ownership in Search Console via the HTML tag method.
PUBLIC_GOOGLE_SITE_VERIFICATION=
